# ViaRoute production settings. Copy to .env.production on the server and fill in.
# Never commit the real file.

# ---------- Domain ----------
ROOT_DOMAIN=viaroute.com
WEB_ORIGIN=https://viaroute.com
# Public API address — carrier webhook URLs are built from it (Admin → Carriers shows them)
API_ORIGIN=https://api.viaroute.com
ACME_EMAIL=you@viaroute.com
# Customers point custom domains here (CNAME). Create this DNS record → your server IP.
CUSTOM_DOMAIN_TARGET=domains.viaroute.com

# ---------- Database ----------
# Managed Postgres (recommended). For --profile local-db use:
# postgresql://viaroute:${POSTGRES_PASSWORD}@postgres:5432/viaroute?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/viaroute?schema=public&sslmode=require
POSTGRES_PASSWORD=

# ---------- Redis ----------
# Managed Redis/Valkey (DigitalOcean, Aiven, Upstash fixed plan…). TLS addresses start with rediss://
# Leave empty and add --profile local-redis to run Redis on the server.
REDIS_URL=rediss://default:PASSWORD@HOST:25061

# ---------- Recordings (bucket) ----------
# Cloudflare R2: create bucket + API token (Object Read & Write) → endpoint https://<account id>.r2.cloudflarestorage.com
# Also works with AWS S3 (leave S3_ENDPOINT empty, set S3_REGION), Backblaze B2, DigitalOcean Spaces.
# Leave S3_BUCKET empty to keep recordings on the server's disk.
S3_BUCKET=viaroute-recordings
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Secrets (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----------
JWT_SECRET=
# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
JWT_EXPIRES_IN=7d

# ---------- Email (e.g. Resend) ----------
SMTP_URL=smtps://resend:RESEND_API_KEY@smtp.resend.com:465
MAIL_FROM=ViaRoute <no-reply@viaroute.com>

# ---------- Telnyx ----------
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CONNECTION_ID=

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Pricing ----------
NUMBER_PRICE_LOCAL=2.00
NUMBER_PRICE_TOLL_FREE=3.00
TRIAL_DAYS=14
