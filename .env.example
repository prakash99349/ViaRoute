# ---------- Database ----------
DATABASE_URL="postgresql://viaroute:viaroute@localhost:5432/viaroute?schema=public"
REDIS_URL="redis://localhost:6379"

# ---------- API ----------
API_PORT=4000
# Public URL of the API (carrier webhooks point here)
API_ORIGIN="http://localhost:4000"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
# Root domain used to resolve tenant subdomains (acme.localhost -> tenant "acme")
ROOT_DOMAIN="localhost"
WEB_ORIGIN="http://localhost:3000"

# ---------- Web ----------
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# ---------- Telnyx (Module 3+) ----------
TELNYX_API_KEY=""
TELNYX_PUBLIC_KEY=""
# Call Control application id (needed from Module 5)
TELNYX_CONNECTION_ID=""
# Leave TELNYX_API_KEY empty to use simulated test numbers

# ---------- Number pricing (USD per month, charged to customers) ----------
NUMBER_PRICE_LOCAL=2.00
NUMBER_PRICE_TOLL_FREE=3.00

# ---------- Stripe (Module 8) ----------
# Leave empty for test mode (top-ups are credited instantly without payment).
# Webhook endpoint in Stripe: https://api.<domain>/webhooks/stripe  (event: checkout.session.completed)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------- Email ----------
# Local: Mailpit (inbox at http://localhost:8025). Production: e.g. smtp://resend:API_KEY@smtp.resend.com:465
SMTP_URL="smtp://localhost:1025"
MAIL_FROM="ViaRoute <no-reply@viaroute.local>"

# ---------- Security ----------
# 32-byte hex key used to encrypt 2FA secrets at rest
ENCRYPTION_KEY="change-me-64-hex-chars"

TRIAL_DAYS=14
